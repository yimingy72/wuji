+def _loopback_model(url):
+    target = urlsplit(url)
+    if (
+        target.scheme != "http"
+        or not target.hostname
+        or target.username
+        or target.password
+        or target.query
+        or target.fragment
+    ):
+        return False
+    if target.hostname == "localhost":
+        return True
+    try:
+        return ip_address(target.hostname).is_loopback
+    except ValueError:
+        return False
