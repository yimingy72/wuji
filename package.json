{
  "name": "wuji-workspace",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": "24.x", "pnpm": "10.32.1" },
  "scripts": {
    "bootstrap:toolchain": "./scripts/bootstrap-toolchain.sh",
    "toolchain:check": "node scripts/check-toolchain.mjs && ./scripts/uv.sh --version && ./scripts/uv.sh run --frozen python -VV",
    "python:sync": "./scripts/uv.sh sync --frozen",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check && redocly lint packages/contracts/openapi.yaml",
    "test": "vitest run",
    "test:contracts": "vitest run tests/contracts.test.mjs",
    "test:contracts:browser": "playwright test --config playwright.contracts.config.ts",
    "build:contracts:browser": "pnpm --filter @wuji/web exec vite build ../../tests/contracts-browser --outDir ../../work/contracts-vite-build --emptyOutDir",
    "antd:check:platform": "antd lint apps/web/src --format json && antd lint packages/theme/src --format json && antd lint spikes/frontend/src --format json",
    "typecheck": "pnpm --filter @wuji/frontend-spike typecheck",
    "check": "pnpm contracts:check && pnpm test && pnpm typecheck",
    "check:api": "./scripts/uv.sh run --frozen python -c 'import wuji_api' && ./scripts/uv.sh run --frozen pytest -m unit",
    "check:platform:scripts": "./scripts/uv.sh run --frozen python -m py_compile apps/api/src/wuji_api/run_file.py scripts/platform/common.py scripts/platform/exec-child.py scripts/platform/lifecycle.py scripts/platform/control.py && sh -n scripts/platform/lifecycle.sh scripts/platform/control.sh scripts/platform/test-platform.sh",
    "check:platform": "pnpm toolchain:check && pnpm check && pnpm antd:check:platform && pnpm --filter @wuji/theme typecheck && pnpm --filter @wuji/web build && pnpm check:api && pnpm check:platform:scripts",
    "build": "pnpm --filter @wuji/frontend-spike build",
    "build:platform": "pnpm --filter @wuji/web build",
    "dev": "pnpm --filter @wuji/frontend-spike dev",
    "dev:api": "./scripts/uv.sh run --frozen uvicorn wuji_api.main:app --host 127.0.0.1 --port 8000",
    "dev:web": "pnpm --filter @wuji/web dev",
    "dev:infra": "./scripts/platform/lifecycle.sh dev-infra",
    "dev:seed": "./scripts/platform/lifecycle.sh dev-seed",
    "dev:platform": "./scripts/platform/lifecycle.sh dev-platform",
    "dev:down": "./scripts/platform/lifecycle.sh dev-down",
    "test:e2e": "playwright test",
    "test:platform:lifecycle": "./scripts/uv.sh run --frozen pytest tests/platform-lifecycle",
    "test:platform": "./scripts/platform/test-platform.sh"
  },
  "devDependencies": {
    "@ant-design/cli": "6.6.3",
    "@playwright/test": "1.63.0",
    "@redocly/cli": "2.51.2",
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "yaml": "2.9.0"
  }
}
