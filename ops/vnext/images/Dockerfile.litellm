# Standalone local LiteLLM image for the first-use fallback.
# The base is an already-present immutable local platform image; this image
# does not inherit or start the Wuji runtime entrypoint.
FROM 127.0.0.1:56615/wuji-vnext-platform@sha256:58a4a979b670dcb416bc33d23a7956fa691a42c98594c26c1fa0c1e4b793659d

USER root
WORKDIR /opt/litellm

RUN python -m venv --copies /opt/litellm/.venv \
    && /opt/litellm/.venv/bin/python -m pip install --no-cache-dir 'litellm[proxy]==1.100.0'

# The proxy extra alone does not install its optional persistent-DB client.
# Generate from the package's own schema at build time, without a DB or key.
ENV PRISMA_BINARY_CACHE_DIR=/opt/litellm/prisma-cache \
    PRISMA_NODEENV_CACHE_DIR=/opt/litellm/prisma-nodeenv \
    PATH=/opt/litellm/.venv/bin:$PATH
COPY ops/vnext/images/litellm-prisma.toml /opt/litellm/pyproject.toml
RUN /opt/litellm/.venv/bin/python -m pip install --no-cache-dir 'prisma==0.11.0' \
    && /opt/litellm/.venv/bin/prisma generate \
       --schema /opt/litellm/.venv/lib/python3.13/site-packages/litellm_proxy_extras/schema.prisma \
    && /opt/litellm/.venv/bin/python -c "from prisma import Prisma; from importlib.metadata import version; assert version('prisma') == '0.11.0'"

COPY ops/vnext/litellm_hooks.py /opt/litellm/ops/vnext/litellm_hooks.py
COPY templates/LITELLM_GATEWAY_DEEPSEEK.example.yaml /opt/litellm/config.yaml

RUN chown -R 10001:10000 /opt/litellm

ENV PATH=/opt/litellm/.venv/bin:$PATH \
    PYTHONPATH=/opt/litellm \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER 10001:10000

# Only LiteLLM is launched. SecretRef/DB env vars are supplied at runtime by
# the gateway owner; no provider key is baked into this image.
ENTRYPOINT ["/opt/litellm/.venv/bin/litellm", "--config", "/opt/litellm/config.yaml", "--host", "0.0.0.0", "--port", "4000", "--num_workers", "1"]
